rules_version = '2';

// TIEMVIO – Firestore Security Rules.
// The free Firebase plan has no server code, so these rules are the server-side gatekeeper:
// only signed-in Google accounts that the owner listed in `users` (and left active) can touch data, and each
// role may only write what it needs. Replace the owner address below (or run `npm run set-owner -- you@gmail.com`).
service cloud.firestore {
  match /databases/{database}/documents {

    function ownerEmail() { return 'owner@example.invalid'; }

    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function mail() { return request.auth.token.email.lower(); }
    function profile() { return get(/databases/$(database)/documents/users/$(mail())).data; }
    function isStaff() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(mail()))
        && profile().active == true && (profile().role in ['owner', 'sales'] || (profile().role == 'support' && mail() == 'support-editor@example.invalid'));
    }
    // Support reads shop data; only the named maintainer may edit operational data. Only owners edit AI configuration and administer accounts.
    function isSupport() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(mail()))
        && profile().active == true && profile().role == 'support';
    }
    function isOwner() { return isStaff() && profile().role == 'owner'; }
    function isManager() { return isOwner() || (isStaff() && profile().role == 'support' && mail() == 'support-editor@example.invalid'); }
    function changed(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function isInt(v) { return v is int; }

    // Accounts. The configured owner can create their own record the first time they sign in.
    match /users/{email} {
      allow read: if isOwner() || isSupport() || (signedIn() && mail() == email);
      allow create: if (isOwner() && email != mail())
        || (signedIn() && mail() == email && email == ownerEmail() && request.resource.data.role == 'owner' && request.resource.data.active == true);
      allow update: if isOwner() && email != mail();
      allow delete: if isOwner() && email != mail() && email != ownerEmail();
    }

    // Owners and the named support editor can use shared AI keys; only owners change them. Sales and other support accounts cannot read them.
    // The per-owner documents of the first version stay readable by their owner so they can be moved into the shared one.
    match /aiConfig/{id} {
      allow read: if (isManager() && id == 'shared') || (isOwner() && mail() == id);
      allow create, update: if isOwner() && id == 'shared' && request.resource.data.keys().hasOnly(['provider', 'keys', 'models']);
    }


    // Shared AI threads expire seven days after creation. Bodies are unreadable after expiry even before cleanup runs.
    match /aiChats/{id} {
      allow read: if isManager();
      allow create: if isManager() && request.resource.data.keys().hasOnly(['title','createdAt','expiresAt','updatedAt','createdBy','createdByName','turnIds'])
        && request.resource.data.createdBy == mail() && request.resource.data.title is string && request.resource.data.title.size() <= 100
        && request.resource.data.createdByName is string && request.resource.data.turnIds == []
        && request.resource.data.createdAt is int && request.resource.data.createdAt >= request.time.toMillis() - 300000 && request.resource.data.createdAt <= request.time.toMillis() + 300000
        && request.resource.data.expiresAt == request.resource.data.createdAt + 604800000 && request.resource.data.updatedAt == request.resource.data.createdAt;
      allow update: if isManager() && resource.data.expiresAt > request.time.toMillis() && changed(['updatedAt','turnIds'])
        && request.resource.data.turnIds is list && request.resource.data.turnIds.size() == resource.data.turnIds.size() + 1
        && request.resource.data.turnIds.hasAll(resource.data.turnIds) && request.resource.data.updatedAt is int;
      allow delete: if isManager() && resource.data.expiresAt <= request.time.toMillis();
      match /turns/{turn} {
        function thread() { return get(/databases/$(database)/documents/aiChats/$(id)).data; }
        allow read: if isManager() && thread().expiresAt > request.time.toMillis();
        allow create: if isManager() && thread().expiresAt > request.time.toMillis()
          && getAfter(/databases/$(database)/documents/aiChats/$(id)).data.turnIds.hasAny([turn])
          && request.resource.data.keys().hasOnly(['createdAt','by','name','messages','log'])
          && request.resource.data.by == mail() && request.resource.data.name is string && request.resource.data.createdAt is int
          && request.resource.data.messages is string && request.resource.data.log is string
          && request.resource.data.messages.size() + request.resource.data.log.size() <= 450000;
        allow delete: if isManager() && thread().expiresAt <= request.time.toMillis();
      }
    }

    // Staff work schedule: the owner plans it and sees everyone; a staff member can read only their own shifts.
    match /schedule/{id} {
      allow read: if isManager() || isSupport() || (isStaff() && resource.data.email == mail());
      allow create, update: if isManager()
        && request.resource.data.email is string && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.start.matches('^[0-2][0-9]:[0-5][0-9]$') && request.resource.data.end.matches('^[0-2][0-9]:[0-5][0-9]$');
      allow delete: if isManager();
    }

    match /settings/{doc} {
      allow read: if isStaff() || isSupport();
      allow write: if isManager();
    }

    match /menu/{id} {
      allow read: if isStaff() || isSupport();
      allow delete: if isManager();
      allow create, update: if isManager()
        && request.resource.data.kind in ['drink', 'topping', 'food']
        && isInt(request.resource.data.priceM) && request.resource.data.priceM >= 0 && request.resource.data.priceM <= 1000000
        && isInt(request.resource.data.priceL) && request.resource.data.priceL >= 0 && request.resource.data.priceL <= 1000000;
    }
    match /menuImages/{id} {
      allow read: if isStaff() || isSupport();
      allow write: if isManager() && (request.method == 'delete' || request.resource.data.image.size() <= 60000);
    }

    // Orders: staff create their own orders at version 1; updates must bump the version by one, never touch the
    // money fields or history identity, only the owner may refund or reconcile, any staff member may cancel or edit an unpaid order.
    match /orders/{id} {
      allow read: if isStaff() || isSupport();
      allow create: if isStaff()
        && request.resource.data.creator == mail()
        && request.resource.data.version == 1
        && isInt(request.resource.data.total) && request.resource.data.total >= 0 && request.resource.data.total <= 100000000
        && request.resource.data.items.size() >= 1 && request.resource.data.items.size() <= 40;
      allow update: if isStaff()
        && resource.data.get('restructured', null) == null
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.creator == resource.data.creator
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.requestKey == resource.data.requestKey
        && request.resource.data.audit.size() == resource.data.audit.size() + 1
        && (
          // Status, payment and cancel/refund changes: the items and the total never change.
          (request.resource.data.total == resource.data.total
            && request.resource.data.items == resource.data.items
            && (request.resource.data.status == resource.data.status || request.resource.data.status != 'cancelled' || isManager()
              || (resource.data.paid == false && request.resource.data.paid == false))
            && (!(resource.data.unreconciled == true && request.resource.data.unreconciled == false && request.resource.data.paid == resource.data.paid) || isManager())
            // Once money is collected, only the owner may change how it was paid (cash / transfer / split) or un-pay the order.
            && (resource.data.paid == false || isManager()
              || (request.resource.data.paid == true && request.resource.data.paymentMethod == resource.data.paymentMethod
                && request.resource.data.get('cashPart', 0) == resource.data.get('cashPart', 0))))
          ||
          // Editing an open order that has not been paid: items and total may change, but not its status or payment.
          (resource.data.paid == false && request.resource.data.paid == false
            && resource.data.status in ['waiting', 'making', 'ready'] && request.resource.data.status == resource.data.status
            && request.resource.data.paymentMethod == resource.data.paymentMethod
            && request.resource.data.paidAt == resource.data.paidAt
            && isInt(request.resource.data.total) && request.resource.data.total >= 0 && request.resource.data.total <= 100000000
            && request.resource.data.items.size() >= 1 && request.resource.data.items.size() <= 40)
        );
      allow delete: if isManager() && resource.data.status in ['delivered', 'cancelled'] && resource.data.get('unreconciled', false) != true;
    }

    match /inventory/{id} {
      allow read: if isStaff() || isSupport();
      allow create, delete: if isManager();
      // Selling decrements stock, so any staff member may change the stock number – and nothing else.
      allow update: if isManager() || (isStaff() && changed(['stock']));
    }
    match /recipes/{id} {
      allow read: if isStaff() || isSupport();
      allow write: if isManager();
    }

    match /customers/{phone} {
      allow read: if isStaff() || isSupport();
      allow create, update: if isStaff() && phone.matches('^0[0-9]{9,10}$');
      allow delete: if false;
    }

    match /expenses/{id} {
      allow read: if isManager() || isSupport();
      allow create: if isManager();
      allow update: if isManager() && changed(['voided']);
      allow delete: if isManager();   // clearing old data (the app refuses anything newer than 30 days)
    }

    match /shifts/{id} {
      allow read: if isStaff() || isSupport();
      allow create: if isStaff() && request.resource.data.openedBy == mail();
      allow update: if isStaff() && resource.data.closedAt == '' && changed(['closedAt', 'closedBy', 'closingCash', 'expectedCash', 'difference', 'note']);
      allow delete: if isManager() && resource.data.closedAt != '';
    }

    // Promotions: the owner defines them, every staff member can apply the ones that are active.
    match /promos/{id} {
      allow read: if isStaff() || isSupport();
      allow delete: if isManager();
      allow create, update: if isManager()
        && request.resource.data.type in ['percent', 'amount']
        && isInt(request.resource.data.value) && request.resource.data.value >= 1 && request.resource.data.value <= 100000;
    }

    // Per-day order number counter, bumped by whoever rings up the order.
    match /counters/{day} {
      allow read: if isStaff() || isSupport();
      allow create, update: if isStaff() && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && isInt(request.resource.data.n);
      allow delete: if isManager();
    }

    // Stock movement history: owner only, append-only.
    match /stockLog/{id} {
      allow read: if isManager() || isSupport();
      allow create: if isManager();
      allow update: if false;
      allow delete: if isManager();
    }

    // Time clock: each person clocks themselves in and out and can read only their own entries;
    // the owner reads everyone's and may clock someone out who forgot.
    match /timeclock/{id} {
      allow read: if isManager() || isSupport() || (isStaff() && resource.data.email == mail());
      allow create: if isStaff() && request.resource.data.email == mail() && request.resource.data.outAt == '';
      allow update: if isStaff() && changed(['outAt']) && resource.data.outAt == ''
        && (isManager() || resource.data.email == mail());
      allow delete: if isManager() && resource.data.outAt != '';
    }

    // Daily totals for fast reports. Staff write them as orders are paid or refunded; only the owner reads them.
    match /stats/{day} {
      allow read: if isManager() || isSupport();
      allow create, update: if isStaff();
      allow delete: if isManager();      // a staff member cannot wipe the revenue history
    }
  }
}
